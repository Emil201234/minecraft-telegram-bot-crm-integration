# ==========================================
# TELEGRAM BOT SETTINGS
# ==========================================
# Токен вашего бота (получить у @BotFather)
BOT_TOKEN=your_telegram_bot_token_here

# Включить демо-режим (True/False).
# В демо-режиме бот не подключается к реальному RCON и AuthMe, используя тестовые данные.
DEMO_MODE=True

# ==========================================
# STAFF & CONTACTS
# ==========================================
# ID администраторов в Telegram (через запятую, без пробелов).
# Узнать свой ID можно у бота @userinfobot
ADMINS=123456789,987654321

# Контакты техподдержки и предложений (например, @username или ссылка)
TECH_SUPPORT=@your_support_username
SUGGESTION=@your_suggestion_username

# ==========================================
# DATABASE PATHS (SQLite)
# ==========================================
# Пути к файлам баз данных
USERS_DB=users.db
LINKS_DB=links.db
# Путь к базе AuthMe (только если DEMO_MODE=False)
AUTH_ME_DB=plugins/AuthMe/authme.db

# ==========================================
# MINECRAFT RCON SETTINGS
# (Заполняется только если DEMO_MODE=False)
# ==========================================
# IP-адрес и порт RCON вашего Minecraft-сервера
RCON_HOST=127.0.0.1
RCON_PORT=25575
# Пароль от RCON (указывается в server.properties)
RCON_PASSWORD=your_rcon_password